# Node Environment
NODE_ENV=development
PORT=5000

# Database URLs (Neon)
# Pooled connection for the running application
DATABASE_URL=postgresql://user:password@ep-sample-pooler.region.neon.tech/dbname?sslmode=require
# Direct connection for running migrations (drizzle-kit)
DATABASE_URL_DIRECT=postgresql://user:password@ep-sample.region.neon.tech/dbname?sslmode=require

# CORS & Networking
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
TRUST_PROXY_HOPS=1

# JWT Secrets & Configuration
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_chars
JWT_ISSUER=domestic-services-api
JWT_AUDIENCE=domestic-services-client
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Security & Hashing
BCRYPT_ROUNDS=10
CALL_IP_HMAC_SECRET=replace_with_a_secure_hmac_secret_at_least_32_chars
CALL_CLICK_DEDUP_WINDOW_SECONDS=300

# Cloud Object Storage (S3-compatible, private bucket)
CLOUD_STORAGE_BUCKET=domestic-services-id-docs
CLOUD_STORAGE_REGION=us-east-1
CLOUD_STORAGE_ENDPOINT=
CLOUD_STORAGE_ACCESS_KEY_ID=your_access_key_id
CLOUD_STORAGE_SECRET_ACCESS_KEY=your_secret_access_key
ID_DOCUMENT_MAX_BYTES=10485760
ID_DOCUMENT_SIGNED_URL_TTL_SECONDS=120

# Media Allowlist
MEDIA_HOST_ALLOWLIST=res.cloudinary.com,images.unsplash.com

# Initial Seed Admin Account
ADMIN_INITIAL_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=replace_with_secure_initial_admin_password
